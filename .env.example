# Copy to .env for local runs. Never commit .env.
# Render reads these from the service environment, not from this file.

# Local MongoDB (docker compose overrides this to mongodb://mongo:27017/).
# Atlas example (do not put a real password here):
# MONGO_URI=mongodb+srv://webhook_app:URL_ENCODED_PASSWORD@cluster.example.mongodb.net/github_events?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=github_events
MONGO_COLLECTION=events

# Shared secret configured on the GitHub webhook. Use a long random string.
WEBHOOK_SECRET=replace-with-a-long-random-string

# true replays bundled sample events on startup and enables POST /demo/replay
# without a token, so a visitor can see the dashboard. The endpoint only
# inserts the files in samples/. Set this to false once a real repository
# webhook is the source of events.
DEMO_MODE=true

# Required to call POST /demo/replay when DEMO_MODE is not true.
DEMO_TOKEN=replace-with-another-random-string

LOG_LEVEL=INFO
PORT=5000
